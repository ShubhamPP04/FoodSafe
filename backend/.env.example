# ── Required ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
SECRET_KEY=your_secret_key_here
POSTGRES_PASSWORD=your_db_password

# ── Synthetic (synthetic.new) — fallback when Gemini 429s ──
#   TEXT   → gpt-oss-120b  (fast, non-reasoning, ~2s per call)
#   VISION → Kimi-K2.7-Code (reasoning model with strong vision capability)
SYNTHETIC_API_KEY=syn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SYNTHETIC_MODEL=hf:openai/gpt-oss-120b
SYNTHETIC_VISION_MODEL=hf:moonshotai/Kimi-K2.7-Code

# ── Database (MongoDB Atlas — primary) ─────────────────
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=foodsafe

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── CORS / Frontend ─────────────────────────────────────
FRONTEND_DOMAIN=your-app.vercel.app
VITE_API_URL=http://localhost:8000/api
CORS_ORIGINS=["http://localhost:3000","https://your-app.vercel.app"]

# ── Twilio (WhatsApp) ────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Push Notifications ───────────────────────────────────
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_EMAIL=mailto:you@example.com

# ── Optional ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
APP_ENV=production
